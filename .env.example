# ===== متغیرهای محیطی خوارزمی یار =====
# این فایل رو کپی کن به .env و مقادیر واقعی رو بذار
# در سرور تولید (Vercel) این‌ها رو در بخش Environment Variables وارد کن

# --- دیتابیس ---
# توسعه محلی (SQLite):
DATABASE_URL="file:./dev.db"

# تولید (PostgreSQL از Neon) — خط بالا رو پاک کن و این رو فعال کن:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- احراز هویت (مهم برای امنیت!) ---
# تولید یک رشته تصادفی: openssl rand -base64 48
# یا از سایت https://randomkeygen.com
NEXTAUTH_SECRET="یک-رشته-تصادفی-طولانی-اینجا-بذار"

# آدرس سایتت (تولید):
NEXTAUTH_URL="http://localhost:3000"
# در تولید مثلاً:
# NEXTAUTH_URL="https://kharazmi-yar.vercel.app"

# --- ورود با گیت‌هاب (اختیاری) ---
# از https://github.com/settings/developers بگیر
GITHUB_ID=""
GITHUB_SECRET=""
# این رو true کن وقتی GitHub OAuth راه انداختی
NEXT_PUBLIC_GITHUB_ENABLED="false"
